# Config
git_ssh.conf
git_ssh_*.conf
!git_ssh_example.conf

# Project-local SSH secrets (keep scripts and git_ssh_*.conf)
.ssh/id_*
.ssh/*_key
.ssh/*_key.pub
.ssh/known_hosts
.ssh/*.bak
.ssh/config
.ssh/git-ssh-env.sh
.ssh/git-ssh-env.ps1
.git-user

# Generated by environment/git/git_ssh_setup
ssh-connect/id_*
ssh-connect/*_key
ssh-connect/*_key.pub
ssh-connect/known_hosts
ssh-connect/*.bak
ssh-connect/config
ssh-connect/.git-user
ssh-connect/git-ssh.sh
ssh-connect/git-ssh.ps1
